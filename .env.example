# ==================================================
# 1. Base de datos PostgreSQL (Neon.tech / Local)
# ==================================================
DB_URL=jdbc:postgresql://<HOST>:<PORT>/<DATABASE>?sslmode=require
DB_USER=<USUARIO>
DB_PASSWORD=<CONTRASENA>

# Puerto del servidor Spring Boot
PORT=8080

# ==================================================
# 2. Configuración Frontend (Vite + React)
# ==================================================
# URL base que consume el cliente Axios
# En local: http://localhost:8080
# En producción: https://<TU_BACKEND_EN_RENDER>.onrender.com
VITE_API_URL=http://localhost:8080

# ==================================================
# 3. Despliegue automatizado opcional (deploy.sh)
# ==================================================
BACKEND_DEPLOY_HOOK=https://api.render.com/deploy/srv-xxxxxx
VERCEL_TOKEN=tu_token_de_vercel
